<?xml version="1.0" encoding="UTF-8" ?>
<!--
The two products (heatwaves/products.py) as ERDDAP datasets. Drafted by
ERDDAP 2.31.1's GenerateDatasetsXml (EDDTableFromNcCFFiles) from the files
themselves, then edited as erddap/README.md describes. The files are where
their own metadata lives; the attributes here only add ERDDAP's (ioos_category,
color bars, subset variables) and replace the few that differ per file.
fileDir is where the products volume is mounted in compose.yaml's erddap service.
-->
<erddapDatasets>

<dataset type="EDDTableFromNcCFFiles" datasetID="gom_heatwaves_daily" active="true">
    <reloadEveryNMinutes>10080</reloadEveryNMinutes>
    <!-- The sync job replaces the files hourly; ERDDAP checks for changes on requests at most this often. -->
    <updateEveryNMillis>10000</updateEveryNMillis>
    <fileDir>/data/products/daily/</fileDir>
    <fileNameRegex>.*_heatwaves_\d{3}m\.nc</fileNameRegex>
    <recursive>false</recursive>
    <pathRegex>.*</pathRegex>
    <metadataFrom>last</metadataFrom>
    <standardizeWhat>0</standardizeWhat>
    <sortFilesBySourceNames>series_id</sortFilesBySourceNames>
    <fileTableInMemory>false</fileTableInMemory>
    <addAttributes>
        <att name="cdm_timeseries_variables">series_id, station, station_name, latitude, longitude, depth, satellite_latitude, satellite_longitude, satellite_distance</att>
        <att name="subsetVariables">series_id, station, station_name, latitude, longitude, depth</att>
        <att name="id">gom_heatwaves_daily</att>
        <att name="title">Marine heatwaves at Gulf of Maine buoys, daily</att>
        <att name="summary">Daily temperature and salinity at 1 to 250 m on the University of Maine&#39;s buoys in the Gulf of Maine, with the 2003-2022 normal, the marine heatwave threshold and anomalies, and the category of each day&#39;s heatwave (Hobday et al. 2016, 2018); at 20 and 50 m, each heatwave&#39;s origin label; and NOAA OISST sea surface temperature at each buoy, treated the same way. One time series per buoy and depth.</att>
        <att name="source">Moored buoys: the {buoy}_ocean_{depth} datasets on https://data.neracoos.org/erddap. Satellite: https://coastwatch.pfeg.noaa.gov/erddap/griddap/ncdcOisst21Agg_LonPM180.html and ncdcOisst21NrtAgg_LonPM180.</att>
        <att name="institution">Max Retter (independent)</att>
        <att name="infoUrl">https://github.com/maxretter/gulfofmaine</att>
        <att name="keywords">Earth Science &gt; Oceans &gt; Ocean Temperature &gt; Water Temperature, Earth Science &gt; Oceans &gt; Ocean Temperature &gt; Sea Surface Temperature, Earth Science &gt; Oceans &gt; Salinity/Density &gt; Salinity, marine heatwaves, anomaly, climatology, buoy, NERACOOS, OISST, Gulf of Maine</att>
        <att name="sourceUrl">(local files)</att>
        <att name="testOutOfDate">now-3days</att>
        <!-- Per-file attributes that don't hold for the whole dataset. -->
        <att name="platform_id">null</att>
        <att name="platform_name">null</att>
    </addAttributes>
    <dataVariable>
        <sourceName>time</sourceName>
        <destinationName>time</destinationName>
        <dataType>double</dataType>
        <addAttributes>
            <att name="ioos_category">Time</att>
            <att name="units">days since 1970-01-01T00:00:00Z</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>series_id</sourceName>
        <destinationName>series_id</destinationName>
        <dataType>String</dataType>
        <addAttributes>
            <att name="ioos_category">Identifier</att>
        </addAttributes>
    </dataVariable>
    <dataVariable>
        <sourceName>station</sourceName>
