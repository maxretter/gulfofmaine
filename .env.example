# Copy to .env for docker compose.
POSTGRES_PASSWORD=change-me
# Host port for the web app.
WEB_PORT=8000
# Where the site is reached, for ERDDAP's links (compose --profile erddap).
ERDDAP_BASE_URL=http://localhost:8000
# Who may set X-Forwarded-For and -Proto: by default any private address. Behind a
# TLS proxy, set it to that proxy's own address (README, "Running it").
#TRUSTED_PROXIES=172.18.0.2
