# Serves the built app and forwards the API to the FastAPI container, so the
# browser sees one origin. TLS is left to whatever sits in front of this.
{
	admin off
	auto_https off
	# The proxy in front, which does the TLS, reaches this from a private address (a Docker network or
	# the host's port mapping): its X-Forwarded-For and -Proto pass through, so the API sees each
	# visitor's address and https, not the proxy's. Anyone else's are replaced. TRUSTED_PROXIES
	# narrows who counts as that proxy: by default any private address, which takes in every other
	# container on a network shared with it; set to the proxy's own address, it alone (README).
	# Strict: Caddy's own idea of the client, for logs and matchers, is then the last address in
	# X-Forwarded-For that isn't a trusted proxy's, not the first, which a client can write itself.
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		trusted_proxies_strict
	}
}

:80 {
	encode zstd gzip

	# On every response: the app's, the API's and ERDDAP's.
	header {
		X-Content-Type-Options nosniff
		# OpenStreetMap's tile servers block requests without a Referer; this sends them only the origin.
		Referrer-Policy strict-origin-when-cross-origin
		# Seen over https, through the proxy in front, it keeps a browser on https for a year.
		# Browsers ignore it over plain http, as locally.
		Strict-Transport-Security max-age=31536000
	}
	# The app's policy, which the API's JSON gets too: inline styles are Leaflet's and
	# React's style attributes; there are no inline scripts. Set only on a response
	# without one of its own: /docs sets its own (heatwaves/main.py), as /erddap does below.
	header ?Content-Security-Policy "default-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"

	# The API and ERDDAP by their aliases in compose.yaml, unique on the host: this container is also
	# on the host's shared proxy network, where another stack's service could be called "api".
	@api path /api/* /docs /openapi.json /healthz
	handle @api {
		reverse_proxy {$API_UPSTREAM:gom-heatwaves-api:8000}
	}

	# Only with Compose's erddap profile; a 502 without it. ERDDAP shares the site's origin, a risk
	# accepted rather than ruled out: a script that got into one of its pages, through a flaw in
	# ERDDAP, would run as the site, and its JSONP responses (JavaScript calling a function named in
	# the URL) count as the site's own scripts under the app's policy above. The site keeps no
	# accounts, cookies or browser storage, so that reaches only public data, though it could change
	# what a visitor sees at the site's address. A subdomain of its own would set it apart (README,
	# "Decisions and limitations").
	handle /erddap* {
		# ERDDAP's pages run inline scripts and event handlers, so this rules out only framing.
		header Content-Security-Policy "frame-ancestors 'none'"
		reverse_proxy {$ERDDAP_UPSTREAM:gom-heatwaves-erddap:8080}
	}

	handle {
		root * /srv
		# Hashed build output never changes under the same name. A name that
		# isn't there, such as an old build's, gets a plain 404, not the app
		# with a year's Cache-Control.
		handle /assets/* {
			@exists file
			header @exists Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		# Any other path is a route in the single-page app. Browsers check
		# index.html with Caddy before reusing it, so after a deploy they load
		# the one that names the new build's assets.
		handle {
			header Cache-Control no-cache
			try_files {path} /index.html
			file_server
		}
	}
}
