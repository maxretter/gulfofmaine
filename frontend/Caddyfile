# Serves the built app and forwards the API to the FastAPI container, so the
# browser sees one origin. TLS is left to whatever sits in front of this.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	@api path /api/* /docs /openapi.json /healthz
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	# Only with Compose's erddap profile; a 502 without it.
	handle /erddap* {
		reverse_proxy {$ERDDAP_UPSTREAM:erddap:8080}
	}

	handle {
		root * /srv
		header {
			X-Content-Type-Options nosniff
			# OpenStreetMap's tile servers block requests without a Referer; this sends them only the origin.
			Referrer-Policy strict-origin-when-cross-origin
			# Inline styles are Leaflet's and React's style attributes; there are no inline scripts.
			Content-Security-Policy "default-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
		}
		# Hashed build output never changes under the same name. A name that
		# isn't there, such as an old build's, gets a plain 404, not the app
		# with a year's Cache-Control.
		handle /assets/* {
			@exists file
			header @exists Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		# Any other path is a route in the single-page app. Browsers check
		# index.html with Caddy before reusing it, so after a deploy they load
		# the one that names the new build's assets.
		handle {
			header Cache-Control no-cache
			try_files {path} /index.html
			file_server
		}
	}
}
