# Serves the built app and forwards the API to the FastAPI container, so the
# browser sees one origin. TLS is left to whatever sits in front of this.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	@api path /api/* /docs /openapi.json /healthz
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	# Only with Compose's erddap profile; a 502 without it.
	handle /erddap* {
		reverse_proxy {$ERDDAP_UPSTREAM:erddap:8080}
	}

	handle {
		root * /srv
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy same-origin
			# Inline styles are Leaflet's and React's style attributes; there are no inline scripts.
			Content-Security-Policy "default-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
		}
		# Hashed build output never changes under the same name.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# Any other path is a route in the single-page app.
		try_files {path} /index.html
		file_server
	}
}
